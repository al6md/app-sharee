# ========================================================
# تبادل الملفات – إعدادات سحابة Cloudflare R2 (10GB مجاناً + نقل بيانات 0$)
# ========================================================

# معرف حسابك في Cloudflare (Cloudflare Account ID)
R2_ACCOUNT_ID=your_cloudflare_account_id

# مفتاح الوصول (Access Key ID)
R2_ACCESS_KEY_ID=your_r2_access_key_id

# المفتاح السري (Secret Access Key)
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# اسم وعاء التخزين في Cloudflare R2
R2_BUCKET_NAME=file-exchange-storage

# (اختياري) النطاق المخصص أو الرابط العام للملفات
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev

# ========================================================
# (اختياري) إعدادات Supabase إن أردت استخدامه كبديل
# ========================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
